# Cloudflare Pages (and Netlify, which reads the same file/syntax) apply
# these to every response matching the path below. Scoped to /tracker/*
# only — the repo root also serves an unrelated document-sales product
# with different embeds (Stripe.js, checkout flows) that this policy was
# never designed against, so it must never apply there.
#
# script-src includes 'unsafe-inline': every one of The Site Office's pages
# is a single static HTML file with its logic in an inline
# <script type="module"> block (no build step, so nothing bundles these
# into external files to hash or nonce) — without 'unsafe-inline' every
# page would fail to load at all. This is a real, deliberate gap in
# script-src specifically; everything else below still holds regardless
# (an attacker-injected <script src="..."> from an unlisted origin is
# still blocked, and connect-src/img-src still block exfiltration to an
# unlisted origin even from an inline-script context).
/tracker/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co; connect-src 'self' https://*.supabase.co https://api.postcodes.io https://api.open-meteo.com https://esm.sh; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# /demo-uae-hv/* — isolated sales-demo environment, entirely separate
# from both the root and /tracker/*. No Supabase, no live data: it runs
# off an in-memory + sessionStorage mock state, so its CSP has no
# Supabase/postcodes/open-meteo origins at all. esm.sh is needed only
# for the same dynamic jsPDF/JSZip imports /tracker/* already allows
# (reused verbatim, not a new dependency). frame-src blob: is the one
# addition versus /tracker/*'s policy, for the in-page PDF-preview
# modal (an <iframe> pointed at a jsPDF-generated blob: URL) — nothing
# else in this demo creates or needs a frame.
# X-Robots-Tag backs up the noindex/nofollow <meta> already on every
# page here and the Disallow rule in robots.txt — three independent
# layers against this route being indexed. None of this is real access
# control: that's the passcode gate in index.html (and, if asked for,
# a Cloudflare Access policy on this path — neither a static _headers
# rule nor a client-side passcode can actually enforce authentication).
/demo-uae-hv/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://esm.sh; frame-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
