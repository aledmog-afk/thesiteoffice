# Supabase — from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. Bypasses RLS — never expose to the browser, never commit.
# Used by the provider-sync routes (build order step 11+), not by anything in
# steps 1-3, so it can stay unset for now.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. AES-256-GCM key for sealing Google/Outlook refresh tokens.
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=
