# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Powers the public .ics calendar feed (bypasses RLS by design — keep secret).
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) — invite emails and the daily digest. Leave unset to log
# invite links to the server console instead of sending real email.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Household OS <onboarding@resend.dev>"

# Used to build absolute links in emails (invite links, etc).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
